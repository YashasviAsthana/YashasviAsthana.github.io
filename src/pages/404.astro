---
// Not found. GitHub Pages serves this file for any missing path.
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { CONTENT } from "../data/content";
---

<Base title={`Page not found | ${CONTENT.name}`} description="This page does not exist." path="/404" noindex>
  <a class="skip" href="#main">Skip to content</a>
  <main id="main" class="lost">
    <svg class="lost-floor" viewBox="0 0 280 84" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="joints" width="28" height="28" patternUnits="userSpaceOnUse">
          <path d="M28 0H0V28" fill="none" style="stroke: var(--line)" stroke-width="1" />
        </pattern>
        <pattern id="hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="4.5" height="9" style="fill: var(--accent)" opacity="0.5" />
        </pattern>
      </defs>
      <rect width="280" height="84" fill="url(#joints)" />
      <path class="lost-route" d="M28 42H168" fill="none" style="stroke: var(--accent-2)" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" />
      <rect x="196" y="0" width="84" height="84" fill="url(#hatch)" />
      <rect x="203" y="7" width="70" height="70" style="fill: var(--bg)" />
      <text x="238" y="47" text-anchor="middle" dominant-baseline="middle" font-size="15" style="fill: var(--muted); font-family: var(--font-mono)">404</text>
      <g class="lost-bot">
        <rect x="5" y="33" width="18" height="18" rx="4" style="fill: var(--ink)" />
        <circle cx="13" cy="42" r="2.6" style="fill: var(--accent-2)" />
        <rect x="17.5" y="37.5" width="1.8" height="9" style="fill: var(--bg)" />
      </g>
      <rect x="168" y="36" width="12" height="12" rx="2" fill="none" style="stroke: var(--accent)" stroke-width="1.5" stroke-dasharray="3 3" />
    </svg>
    <h1>No path to this page.</h1>
    <p class="lost-note">
      The planner searched every aisle and the reservation table came back empty. The page may have moved, or it never existed.
    </p>
    <ul class="links" aria-label="Links">
      <li><a class="btn btn--primary" href="/">Back to the floor</a></li>
    </ul>
  </main>
  <Footer backHref="/" backLabel="Home" />
</Base>

<style>
  .lost {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(72px, 14vh, 160px) var(--gutter) 0;
  }
  .lost-floor {
    display: block;
    width: min(100%, 420px);
    height: auto;
    margin: 0 0 40px;
  }
  .lost-bot { animation: lost-roll 4.5s ease-in-out infinite; }
  @keyframes lost-roll {
    0%, 12% { transform: translateX(0); }
    55%, 70% { transform: translateX(140px); }
    100% { transform: translateX(0); }
  }
  h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    line-height: var(--d-lead);
    font-size: calc(clamp(2.55rem, 1.35rem + 3.1vw, 4.4rem) * var(--d-scale));
    text-wrap: balance;
  }
  .lost-note {
    margin: 18px 0 0;
    max-width: 50ch;
    color: var(--muted);
    font-size: clamp(1rem, 0.94rem + 0.22vw, 1.125rem);
  }
</style>
